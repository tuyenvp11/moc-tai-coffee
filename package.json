{
  "name": "moc-tai-coffee",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && node scripts/build-worker.mjs",
    "start": "npm run start --workspace backend",
    "test": "node --test backend/test/*.test.js",
    "test:production": "node scripts/verify-production.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
